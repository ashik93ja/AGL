   <a href="mailto:YOUR_EMAIL@gmail.com">Email Us</a>
  </div>
 </div>
</section>
</main>

<footer>
 <strong>AGL | ASHIK GROUP LIMITED</strong>
 <p>© 2026 AGL. All Rights Reserved.</p>
 <p>Think Big • Build Smart • Grow Together</p>
</footer>

<script>
function toggleMenu(){
 document.getElementById('nav').classList.toggle('open');
}
function closeMenu(){
 document.getElementById('nav').classList.remove('open');
}
</script>

</body>
</html>
